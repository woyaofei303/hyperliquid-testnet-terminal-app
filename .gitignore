app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# 不提交本地配置、凭据或子工程构建报告。
.env
.env.*
!.env.example
*.p12
*.pfx
/android/build/

# Android 源资源必须入库，覆盖个人全局 *.xml 忽略规则。
!/android/app/src/**/AndroidManifest.xml
!/android/app/src/main/res/**/*.xml
